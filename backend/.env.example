MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/syncwrite?retryWrites=true&w=majority
# If your password contains special characters (@, :, /, etc.), percent-encode them (e.g. @ becomes %40).
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=5000
CLIENT_URL=http://localhost:5173
# For multiple allowed origins use a comma-separated list, e.g.:
# CLIENT_URL=http://localhost:5173,https://your-frontend.onrender.com
# Localhost (http://localhost:*) and http://127.0.0.1:* origins are always allowed in development.

# Optional SMTP config for password reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
